{
  "version": 3,
  "denyKeywords": [
    "rm -rf",
    "rm -fr",
    "rm -r -f",
    "rm --recursive --force",
    "sudo rm",
    "chmod 777 /",
    "dd of=",
    "mkfs",
    "mkfs.ext",
    "drop table",
    "drop database",
    "delete from",
    "truncate table",
    "truncate ",
    "terraform destroy",
    "revoke",
    "清空数据库",
    "删除数据库",
    "格式化",
    "push --force",
    "force-push",
    "force push",
    "git reset --hard",
    "git clean -fd",
    "docker rm",
    "docker system prune",
    "shutdown",
    "reboot",
    "remove-item -recurse -force",
    "remove-item -force -recurse",
    "remove-item -r -fo",
    "remove-item -fo -r",
    "rmdir /s /q",
    "rmdir /q /s",
    "rd /s /q",
    "rd /q /s",
    "del /f /s /q",
    "del /s /q /f",
    "del /s /q",
    "del /q /s",
    "del /f /q",
    "erase /f /s /q",
    "erase /s /q",
    "format c:",
    "format d:",
    "format-volume",
    "clear-disk",
    "initialize-disk",
    "diskpart",
    "remove-partition",
    "cipher /w:",
    "vssadmin delete shadows",
    "vssadmin resize shadowstorage",
    "wmic shadowcopy delete",
    "wbadmin delete catalog",
    "wbadmin delete systemstatebackup",
    "reg delete",
    "reg add",
    "reg restore",
    "reg import",
    "reg load",
    "remove-itemproperty",
    "remove-item hklm:",
    "remove-item hkcu:",
    "remove-item registry::",
    "set-itemproperty -path hklm:",
    "set-itemproperty -path hkcu:",
    "stop-computer",
    "restart-computer",
    "bcdedit",
    "bootrec",
    "takeown",
    "icacls",
    "set-acl",
    "set-mppreference",
    "add-mppreference",
    "disablerealtimemonitoring",
    "netsh advfirewall set",
    "netsh firewall set",
    "set-netfirewallprofile",
    "wevtutil cl",
    "clear-eventlog",
    "auditpol /clear",
    "auditpol /set",
    "sc delete",
    "sc stop",
    "sc config",
    "stop-service",
    "remove-service",
    "set-service",
    "taskkill /f",
    "taskkill /im",
    "stop-process -force",
    "mimikatz",
    "procdump",
    "reg save hklm\\sam",
    "reg save hklm\\system",
    "reg save hklm\\security",
    "net user",
    "net localgroup",
    "new-localuser",
    "add-localgroupmember",
    "enable-localuser",
    "set-executionpolicy"
  ],
  "allowRules": [
    {
      "mode": "workspace-write",
      "description": "工作区写入（可回补，对应 acceptEdits/workspace-write）"
    },
    {
      "contains": "git",
      "description": "Git 常规操作（clone/fetch/pull/push/commit/checkout 等）自动放行"
    },
    {
      "contains": "github",
      "description": "GitHub/GCM 凭据与网络交互自动放行"
    },
    {
      "tool": "pwsh",
      "mode": "danger-full-access",
      "contains": "git",
      "description": "git 网络/凭据操作(danger-full-access)自动放行"
    },
    {
      "tool": "pwsh",
      "mode": "danger-full-access",
      "contains": "EPERM",
      "description": "沙箱子进程创建受限(EPERM/cmd.exe)自动提权放行"
    }
  ],
  "denyRules": [],
  "hardCategories": [
    "deletion",
    "credential",
    "remote",
    "system",
    "bulk"
  ],
  "riskyThreshold": 3,
  "judgeTimeoutMs": 20000,
  "learning": {
    "enabled": true
  }
}
