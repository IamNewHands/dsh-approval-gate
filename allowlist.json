{
  "version": 4,
  "denyKeywords": [
    "rm -rf",
    "rm -fr",
    "rm -r -f",
    "rm --recursive --force",
    "sudo rm",
    "chmod 777 /",
    "dd of=",
    "mkfs",
    "mkfs.ext",
    "format",
    "drop table",
    "drop database",
    "delete from",
    "truncate ",
    "terraform destroy",
    "revoke",
    "清空数据库",
    "删除数据库",
    "格式化",
    "push --force",
    "force-push",
    "force push",
    "git reset --hard",
    "git clean -fd",
    "docker rm",
    "docker system prune",
    "remove-item -recurse -force",
    "remove-item -force -recurse",
    "remove-item -r -fo",
    "remove-item -fo -r",
    "ri -recurse -force",
    "ri -r -fo",
    "del /f /s /q",
    "del /s /q /f",
    "del /s /q",
    "del /q /s",
    "del /f /q",
    "rmdir /s /q",
    "rmdir /q /s",
    "rd /s /q",
    "rd /q /s",
    "erase /f /s /q",
    "erase /s /q",
    "clear-disk",
    "format-volume",
    "remove-partition",
    "initialize-disk",
    "diskpart",
    "cipher /w:",
    "vssadmin delete shadows",
    "vssadmin resize shadowstorage",
    "wmic shadowcopy delete",
    "wbadmin delete catalog",
    "wbadmin delete systemstatebackup",
    "shutdown",
    "reboot",
    "stop-computer",
    "restart-computer",
    "set-executionpolicy",
    "set-mppreference",
    "add-mppreference",
    "disablerealtimemonitoring",
    "disable-bitlocker",
    "netsh advfirewall",
    "netsh firewall set",
    "set-netfirewallprofile",
    "reg delete",
    "reg add",
    "reg restore",
    "reg import",
    "reg load",
    "remove-itemproperty",
    "remove-item hklm",
    "remove-item hkcu",
    "remove-item registry::",
    "set-itemproperty -path hklm:",
    "set-itemproperty -path hkcu:",
    "takeown",
    "icacls",
    "set-acl",
    "sc delete",
    "sc stop",
    "sc config",
    "stop-service",
    "remove-service",
    "set-service",
    "taskkill /f",
    "taskkill /im",
    "stop-process -force",
    "mimikatz",
    "procdump",
    "reg save hklm\\sam",
    "reg save hklm\\system",
    "reg save hklm\\security",
    "net user",
    "net localgroup",
    "new-localuser",
    "add-localgroupmember",
    "enable-localuser",
    "bcdedit",
    "bootrec",
    "wevtutil cl",
    "clear-eventlog",
    "auditpol /clear",
    "auditpol /set"
  ],
  "allowRules": [
    {
      "mode": "workspace-write",
      "description": "工作区写入（可回补，对应 acceptEdits/workspace-write）"
    },
    {
      "tool": "pwsh",
      "contains": "vitest",
      "description": "放行 Vitest 单元/集成测试与 Worker 子进程执行"
    },
    {
      "tool": "pwsh",
      "contains": "worker process",
      "description": "放行测试框架 Worker 多进程派生与沙箱提权"
    },
    {
      "tool": "pwsh",
      "contains": "child process",
      "description": "放行开发工具链 Child Process 子进程派生与执行"
    },
    {
      "tool": "pwsh",
      "contains": "subprocess",
      "description": "放行 Windows Subprocess 子进程沙箱提权与重试"
    },
    {
      "tool": "pwsh",
      "contains": "wrangler",
      "description": "放行 Cloudflare Wrangler 构建、dry-run、类型生成与 Worker 流程"
    },
    {
      "tool": "pwsh",
      "contains": "build",
      "description": "放行前端与 Worker 项目构建 (build) 流程"
    },
    {
      "tool": "pwsh",
      "contains": "github",
      "description": "放行 GitHub/GCM 凭据调用、变基同步与常规推送"
    },
    {
      "tool": "pwsh",
      "contains": "凭据",
      "description": "放行 Git 凭据管理器调用（解决 Windows 沙箱 Win32 error 5）"
    },
    {
      "tool": "pwsh",
      "contains": "git",
      "description": "放行常规 Git 版本管理与分支同步操作"
    },
    {
      "contains": "git",
      "description": "Git 常规操作（clone/fetch/pull/push/commit/checkout 等）自动放行（不限工具）"
    },
    {
      "contains": "github",
      "description": "GitHub/GCM 凭据与网络交互自动放行（不限工具）"
    },
    {
      "contains": "push",
      "description": "放行常规 Git 推送操作 (push)"
    },
    {
      "contains": "推送",
      "description": "放行常规 Git 代码推送与分支同步操作"
    },
    {
      "tool": "pwsh",
      "contains": ".dsh",
      "description": "放行 DSH Profile 目录插件与依赖配置写入"
    },
    {
      "tool": "pwsh",
      "contains": "pnpm",
      "description": "放行 pnpm 包管理、构建与依赖安装"
    },
    {
      "tool": "pwsh",
      "contains": "tsc",
      "description": "放行 TypeScript 类型检查与编译输出"
    },
    {
      "tool": "pwsh",
      "contains": "typescript",
      "description": "放行 TypeScript 完整类型检查与构建流程"
    },
    {
      "tool": "pwsh",
      "contains": "eslint",
      "description": "放行 ESLint 代码规范与静态检查"
    },
    {
      "tool": "pwsh",
      "mode": "danger-full-access",
      "contains": "git",
      "description": "git 网络/凭据操作(danger-full-access)自动放行"
    },
    {
      "tool": "pwsh",
      "mode": "danger-full-access",
      "contains": "EPERM",
      "description": "沙箱子进程创建受限(EPERM/cmd.exe)自动提权放行"
    },
    {
      "tool": "write",
      "mode": "danger-full-access",
      "contains": "appdata/roaming/rime",
      "keywords": [
        "appdata/roaming/rime",
        "my_phrase.dict.yaml",
        "wanxiang.custom.yaml",
        "wanxiang_phrase.custom.yaml",
        "custom_phrase.dict.yaml"
      ],
      "description": "Rime 用户目录（%APPDATA%\\Rime）的输入法配置与个人词典写入"
    },
    {
      "tool": "edit",
      "mode": "danger-full-access",
      "contains": "appdata/roaming/rime",
      "keywords": [
        "appdata/roaming/rime",
        "my_phrase.dict.yaml",
        "wanxiang.custom.yaml",
        "wanxiang_phrase.custom.yaml",
        "custom_phrase.dict.yaml"
      ],
      "description": "Rime 用户目录（%APPDATA%\\Rime）的输入法配置与个人词典修改"
    },
    {
      "tool": "pwsh",
      "mode": "danger-full-access",
      "contains": "weaseldeployer.exe",
      "keywords": [
        "weaseldeployer.exe",
        "rime.weasel"
      ],
      "description": "小狼毫（Weasel）部署程序重新编译 Rime 词典"
    }
  ],
  "denyRules": [],
  "hardCategories": [
    "deletion",
    "credential",
    "remote",
    "system",
    "bulk"
  ],
  "riskyThreshold": 3,
  "judgeTimeoutMs": 20000,
  "judgeFailureLimit": 1,
  "judgeMaxTokens": 1024,
  "learning": {
    "enabled": true
  }
}
